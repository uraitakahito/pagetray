msgstr "What happened last time"

#: src/run.md
msgid "次に見る所"
msgstr "Where to look next"

#: src/run.md
msgid "`previous: none (first start)`"
msgstr "`previous: none (first start)`"

#: src/run.md
msgid "印が無い。初めて起きた"

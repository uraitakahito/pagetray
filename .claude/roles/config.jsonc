// この repo（とその上の folder）で、roster の TPM 担当を起こしたときの設定。書いていない欄は既定のまま。
{
  // 課題の記録は Jira（acli が login している site。今は future-gadget-laboratory.atlassian.net の AI。コンポーネントは pagetray）に書く。
  "tracker": "jira",
  // roster push が、push の前に流す確かめ（書き方は roster の docs-site の設定のページの「push の前の確かめ」）。
  // CI（ci.yml の test と docs.yml）の中で手元で速く流せる物。試験・image・e2e・model の検査は CI に任せる。
  // roster push は origin/main のこの欄を読むので、変えた一覧は merge の後から効く。
  // 長さ（2026-11-28 に一時の worktree で測った）: fmt 2 秒・clippy 24 秒（作ったばかりの worktree）・0 秒（2 回目）・mdbook 1 秒未満。
  // docs は ci/docs-build.sh でなく mdbook build docs（docs-build.sh は検索の索引に pagefind を要し、手元に無いことがあるため。訳と索引の検査は CI の docs.yml）。
  "push": {
    "checks": [
      {
        "name": "fmt",
        "run": ["cargo", "fmt", "--all", "--check"],
      },
      {
        "name": "clippy",
        "run": ["cargo", "clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
      },
      {
        "name": "docs-build",
        "run": ["mdbook", "build", "docs"],
      },
    ],
  },
  "infra": {
    // ページの置き場（pagetray の container と、DB を置く volume）。止めると担当はページを置けず、
    // volume を消すと置かれたページの記録が消える。起こし方は docs の「動かす」（docs/src/run.md。https://uraitakahito.github.io/pagetray/run.html）。
    // roster の guard の当て方（roster の docs-site の設定のページの「環境の手続き」）のうち、要るところだけ:
    // - 項目は命令の語で当て、末尾に * の語は前方一致（pagetray-data* は volume の pagetray-data-v1 と、-v の値 pagetray-data-v1:/data に当たる）。
    //   container の命令の旗はそろえてから当てるので、--name=…・--volume …・--mount …,source=… も、--name …・-v … の項目で当たる。
    //   語で当たらなくても、命令の字に項目の字（--name=… と --volume … の書き方も）が含まれれば止める。
    // - 名を宣言した container（--name の項目）と volume（-v の項目）を的にする container の命令は、ここに書いていない動詞
    //   （exec・cp・commit・export など）でも止まる。読むだけの logs・inspect・stats・ls（volume は inspect・ls）は通る（roster の t-d37r）。
    "pagetray": {
      "guard": "tpm",
      // container の名は pagetray.box（1.2.0 から。同じ network の container（callboard）が DNS の domain box で名で引く）。
      // 前の名 pagetray の項目も残す（前の名で動かしている間と、前の名で起こし直す試みを止めるため）。
      "match": [
        "--name pagetray.box",
        "container start pagetray.box",
        "container stop pagetray.box",
        "container kill pagetray.box",
        "container delete pagetray.box",
        "container rm pagetray.box",
        "--name pagetray",
        "container start pagetray",
        "container stop pagetray",
        "container kill pagetray",
        "container delete pagetray",
        "container rm pagetray",
        "container volume delete pagetray-data*",
        "container volume rm pagetray-data*",
        // volume を付ける命令（写しから戻すもこれに当たる）。動く pagetray-data-v1 を守る。
        "-v pagetray-data*",
        // volume の略の v（container v rm …）。語が volume と違うので、略の形も並べる（roster の t-9tac）。
        "container v delete pagetray-data*",
        "container v rm pagetray-data*",
      ],
    },
  },
}
